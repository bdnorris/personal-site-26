---
import {
  getSnippet,
  snippetFilename,
  snippetLanguage,
} from "../lib/work";

interface Props {
  file: string;
  language?: string;
}

const { file, language: languageOverride } = Astro.props;
const source = getSnippet(file);
const filename = snippetFilename(file);
const language = languageOverride?.trim() || snippetLanguage(file);
---

<div class="code-block">
  <div class="code-bar">
    <span class="code-dot"></span>
    <span class="code-name">{filename}</span>
  </div>
  <pre><code class={`language-${language}`}>{source}</code></pre>
</div>

<script>
  import { highlightAll } from "microlighter";

  await highlightAll({ selector: ".code-block pre > code" });
</script>
