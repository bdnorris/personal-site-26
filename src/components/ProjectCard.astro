---
import { workHeroAlt, workHeroHint, type WorkItem } from "../lib/work";
import ImageFrame from "./ImageFrame.astro";
import { Image } from "astro:assets";

interface Props {
  item: WorkItem;
  wide?: boolean;
  heading?: "h2" | "h3";
}

const { item, wide = false, heading = "h3" } = Astro.props;

const titleTag = (level: "h2" | "h3"): "h2" | "h3" => {
  switch (level) {
    case "h2":
    case "h3":
      return level;
    default: {
      const unexpected: never = level;
      return unexpected;
    }
  }
};

const Title = titleTag(heading);
const heroSrc = item.hero?.src?.trim() || null;
const indexStack = item.stack.filter((entry) => entry.trim()).slice(0, 3);
const hint = workHeroHint(item);
const alt = workHeroAlt(item);
---

<a class="card" href={`/work/${item.id}`} data-category={item.category}>
  <div class="card-media">
    {
      heroSrc ? (
        <ImageFrame hint={hint} alt={alt} src={heroSrc}>
          <Image
            src={heroSrc}
            alt={alt}
            width={1280}
            height={698}
            widths={[480, 720, 960, 1280]}
            sizes="auto, (max-width: 720px) calc(100vw - 2rem), calc(50vw - 2.5rem)"
            loading="lazy"
          />
        </ImageFrame>
      ) : (
        <ImageFrame hint={hint} />
      )
    }
  </div>
  <div class="card-body">
    <span class="card-meta">{item.category} · {item.year}</span>
    <Title>{item.title}</Title>
    <p>{item.blurb}</p>
    {
      wide && indexStack.length ? (
        <div class="stack">
          {indexStack.map((s) => (
            <span>{s}</span>
          ))}
        </div>
      ) : null
    }
  </div>
</a>
