---
import type { WorkItem } from "../lib/work";
import ImageFrame from "./ImageFrame.astro";

interface Props {
  item: WorkItem;
  wide?: boolean;
}

const { item, wide = false } = Astro.props;
---

<a class="card" href={`/work/${item.id}`} data-category={item.category}>
  <div class:list={["card-media", { "card-media--wide": wide }]}>
    <ImageFrame src={item.image} hint={item.imageHint ?? item.title} alt={item.title} />
  </div>
  <div class="card-body">
    <span class="card-meta">{item.category} · {item.year}</span>
    <h3>{item.title}</h3>
    <p>{item.blurb}</p>
    {
      wide && (
        <div class="stack">
          {item.stack.map((s) => (
            <span>{s}</span>
          ))}
        </div>
      )
    }
  </div>
</a>
