---
import { workHeroAlt, workHeroHint, type WorkItem } from "../lib/work";
import ImageFrame from "./ImageFrame.astro";
import { Image } from "astro:assets";

interface Props {
  item: WorkItem;
  wide?: boolean;
}

const { item, wide = false } = Astro.props;
const heroSrc = item.hero?.src?.trim() || null;
const hint = workHeroHint(item);
const alt = workHeroAlt(item);
---

<a class="card" href={`/work/${item.id}`} data-category={item.category}>
  <div class:list={["card-media", { "card-media--wide": wide }]}>
    {
      heroSrc ? (
        <ImageFrame hint={hint} alt={alt} src={heroSrc}>
          <Image
            src={heroSrc}
            alt={alt}
            width={1100}
            height={600}
            widths={[550, 1100]}
            sizes="(max-width: 550px) 768px, 1100px"
          />
        </ImageFrame>
      ) : (
        <ImageFrame hint={hint} />
      )
    }
  </div>
  <div class="card-body">
    <span class="card-meta">{item.category} · {item.year}</span>
    <h3>{item.title}</h3>
    <p>{item.blurb}</p>
    {
      wide && item.stack.length ? (
        <div class="stack">
          {item.stack.map((s) => (
            <span>{s}</span>
          ))}
        </div>
      ) : null
    }
  </div>
</a>
