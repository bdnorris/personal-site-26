---
import type { WorkItem } from "../lib/work";
import ImageFrame from "./ImageFrame.astro";
import { Image } from "astro:assets";

interface Props {
  item: WorkItem;
  wide?: boolean;
}

const { item, wide = false } = Astro.props;
const heroSrc = item.hero?.src?.trim() || null;
---

<a class="card" href={`/work/${item.id}`} data-category={item.category}>
  <div class:list={["card-media", { "card-media--wide": wide }]}>
    {
      heroSrc ? (
        <Image
          src={heroSrc}
          alt={item.hero?.alt || item.title}
          widths={[800, 1200]}
          sizes="(max-width: 800px) 100vw, (max-width: 1200px) 50vw"
        />
      ) : (
        <ImageFrame hint={item.hero?.hint || item.title} />
      )
    }
  </div>
  <div class="card-body">
    <span class="card-meta">{item.category} · {item.year}</span>
    <h3>{item.title}</h3>
    <p>{item.blurb}</p>
    {
      wide && (
        <div class="stack">
          {item.stack.map((s) => (
            <span>{s}</span>
          ))}
        </div>
      )
    }
  </div>
</a>
