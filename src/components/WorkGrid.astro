---
import { CATEGORIES, countByCategory, type WorkItem } from "../lib/work";
import ProjectCard from "./ProjectCard.astro";

interface Props {
  items: WorkItem[];
}

const { items } = Astro.props;
const filters = CATEGORIES.map((label) => ({
  label,
  count: countByCategory(label),
}));
---

<div class="filters" data-filters>
  {
    filters.map((f, i) => (
      <button
        class:list={["filter", { "is-on": i === 0 }]}
        type="button"
        data-filter={f.label}
      >
        {f.label} <span class="n">{f.count}</span>
      </button>
    ))
  }
</div>

<div class="work-grid" data-work-grid>
  {items.map((item) => <ProjectCard item={item} wide />)}
</div>

<script>
  const filters = document.querySelector("[data-filters]");
  const grid = document.querySelector("[data-work-grid]");
  if (filters && grid) {
    const buttons = Array.from(filters.querySelectorAll<HTMLButtonElement>("[data-filter]"));
    const cards = Array.from(grid.querySelectorAll<HTMLElement>("[data-category]"));

    function apply(cat: string) {
      buttons.forEach((btn) => btn.classList.toggle("is-on", btn.dataset.filter === cat));
      cards.forEach((card) => {
        const show = cat === "All" || card.dataset.category === cat;
        card.classList.toggle("is-hidden", !show);
      });
      const url = new URL(window.location.href);
      if (cat === "All") url.searchParams.delete("cat");
      else url.searchParams.set("cat", cat);
      history.replaceState({}, "", url);
    }

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => apply(btn.dataset.filter || "All"));
    });

    const initial = new URLSearchParams(window.location.search).get("cat");
    const known = buttons.some((btn) => btn.dataset.filter === initial);
    if (initial && known) apply(initial);
  }
</script>
