---
import { ACTIVE_SEASON } from "../lib/seasons";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

{
  ACTIVE_SEASON && (
    <button
      class:list={["season-toggle", className]}
      type="button"
      data-season-toggle
      data-season-id={ACTIVE_SEASON.id}
      aria-pressed="false"
    >
      <svg class="season-toggle-icon" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false">
        <path class="season-toggle-shape" d={ACTIVE_SEASON.icon.shape} />
        {ACTIVE_SEASON.icon.detail && <path class="season-toggle-detail" d={ACTIVE_SEASON.icon.detail} />}
      </svg>
      <span>{ACTIVE_SEASON.label}</span>
    </button>
  )
}

<script>
  function isActive(seasonId: string) {
    return document.documentElement.dataset.season === seasonId;
  }

  function apply(seasonId: string, active: boolean) {
    if (active) {
      document.documentElement.dataset.season = seasonId;
    } else {
      delete document.documentElement.dataset.season;
    }

    try {
      if (active) {
        localStorage.setItem("seasonTheme", seasonId);
      } else {
        localStorage.removeItem("seasonTheme");
      }
    } catch {
      /* ignore */
    }

    document.querySelectorAll<HTMLElement>("[data-season-toggle]").forEach((button) => {
      const pressed = button.dataset.seasonId === seasonId && active;
      button.setAttribute("aria-pressed", String(pressed));
    });
  }

  document.querySelectorAll<HTMLElement>("[data-season-toggle]").forEach((button) => {
    const seasonId = button.dataset.seasonId;
    if (!seasonId) return;

    button.addEventListener("click", () => {
      apply(seasonId, !isActive(seasonId));
    });
  });

  const initialToggle = document.querySelector<HTMLElement>("[data-season-toggle]");
  const initialSeasonId = initialToggle?.dataset.seasonId;
  if (initialSeasonId) {
    apply(initialSeasonId, isActive(initialSeasonId));
  }
</script>
