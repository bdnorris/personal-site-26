---
import HolidayToggle from "./HolidayToggle.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  path: string;
}

const { path } = Astro.props;

const links = [
  { href: "/work", label: "Work", match: (p: string) => p === "/work" || p.startsWith("/work/") },
  { href: "/about", label: "About", match: (p: string) => p === "/about" },
  { href: "/resume", label: "Resume", match: (p: string) => p === "/resume" },
];
---

<div class="theme-controls theme-controls--bar">
  <HolidayToggle />
  <ThemeToggle />
</div>
<div class="mast">
  <header class="mast-row">
    <a class="wordmark" href="/">Brian Norris</a>
    <nav class="nav" aria-label="Primary">
      {
        links.map((link) => {
          const on = link.match(path);
          return (
            <a class:list={["nav-link", { "is-on": on }]} href={link.href} aria-current={on ? "page" : undefined}>
              {link.label}
              <span class="rule" aria-hidden="true"></span>
            </a>
          );
        })
      }
      <span class="nav-rule" aria-hidden="true"></span>
      <div class="theme-controls theme-controls--nav">
        <ThemeToggle />
        <HolidayToggle />
      </div>
    </nav>
  </header>
</div>

<script>
  const mast = document.querySelector(".mast");
  const syncMastHeight = () => {
    if (!(mast instanceof HTMLElement)) return;
    const height = Math.ceil(mast.getBoundingClientRect().height);
    document.documentElement.style.setProperty("--mast-h", `${height}px`);
  };
  syncMastHeight();
  window.addEventListener("resize", syncMastHeight);
</script>
