---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getFeatured } from "../lib/work";
import { getSite } from "../lib/site";

const featured = getFeatured();
const { skills, contacts } = getSite();
---

<BaseLayout title="Brian Norris" description="Front-end developer who lives in the details.">
  <div class="wipe">
    <section class="hero">
      <p class="kicker">
        <span class="kicker-phrase">user experience<span class="dot"> ·</span></span>
        <span class="kicker-phrase">accessibility<span class="dot"> ·</span></span>
        <span class="kicker-phrase">performance</span>
      </p>
      <h1>
        <span>Where design meets code, </span><br>
        <span>I close </span>
        <span class="hero-phrase"><span class="acc">the gap</span>.</span>
      </h1>
      <div class="hero-row">
        <p class="lede">
          Great designs don't automatically become great websites. That's where I come in. I've spent 10+ years building for agencies, clients, and the classroom.
        </p>
        <div class="hero-actions">
          <a class="btn btn-fill" href="/work">See the work</a>
          <a class="btn btn-ghost" href="/resume">Resume</a>
        </div>
      </div>
    </section>

    <section class="section section-rule featured">
      <div class="section-head">
        <h2>Featured work</h2>
        <a class="link-quiet" href="/work">All projects →</a>
      </div>
      <div class="cards">
        {featured.map((item) => <ProjectCard item={item} />)}
      </div>
    </section>

    <section class="section bring">
      <h2>What I bring</h2>
      <div class="skills">
        {
          skills.map((s) => (
            <div class="skill">
              <h3>{s.title}</h3>
              <ul>
                {s.items.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section invite" aria-label="Contact">
      <p class="invite-line">If you want to talk, write or call.</p>
      <div class="invite-links">
        {
          contacts.map((c) => (
            <a href={c.href}>
              <span class="k">{c.k}</span>
              <span class="v">{c.v}</span>
            </a>
          ))
        }
      </div>
    </section>

  </div>
</BaseLayout>
