---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkGrid from "../../components/WorkGrid.astro";
import { getWork } from "../../lib/work";

const items = getWork();
---

<BaseLayout title="Work · Brian Norris" description="Work, education and research, tools and experiments.">
  <div class="work-page">
    <h1>Selected <span class="acc">work</span></h1>
    <p class="intro">Work, education and research, tools and experiments.</p>
    <WorkGrid items={items} />
  </div>
</BaseLayout>
