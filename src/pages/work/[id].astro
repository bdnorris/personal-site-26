---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ImageFrame from "../../components/ImageFrame.astro";
import {
  getNextWork,
  getWork,
  getWorkById,
  yearLabel,
  type WorkVisual,
} from "../../lib/work";
import { Image } from "astro:assets";

export function getStaticPaths() {
  return getWork().map((item) => ({ params: { id: item.id } }));
}

const { id } = Astro.params;
const item = getWorkById(id!);
if (!item) throw new Error(`Unknown work id: ${id}`);

const next = getNextWork(item);
const c = item.case;
const links = (item.links ?? []).filter((link) => link.href.trim());
const meta = [
  { k: "Type", v: item.category },
  c?.client ? { k: "Client", v: c.client } : null,
  c?.role ? { k: "Role", v: c.role } : null,
  { k: yearLabel(item.year), v: item.year },
  { k: "Stack", v: item.stack.join(", ") },
].filter((row): row is { k: string; v: string } => row !== null);

const rich = Boolean(c);
const heroSrc = item.hero?.src?.trim() || null;
---

<BaseLayout title={`${item.title} · Brian Norris`} description={item.blurb}>
  <div class="wipe">
    <section class="case-hero">
      <a class="link-quiet" href="/work">← All work</a>
      <span class="case-kicker">{item.category} · {item.year}</span>
      <h1>{item.title}</h1>
      <p class="case-lede">{c?.lede ?? item.blurb}</p>
      <dl class="meta-grid">
        {
          meta.map((m) => (
            <div class:list={["meta-cell", { "meta-cell--wrap": m.k === "Stack" }]}>
              <dt>{m.k}</dt>
              <dd>
                {m.k === "Stack" ? (
                  <div class="stack">
                    {item.stack.map((s) => (
                      <span>{s}</span>
                    ))}
                  </div>
                ) : (
                  m.v
                )}
              </dd>
            </div>
          ))
        }
      </dl>
      {
        links.length ? (
          <ul class="case-links">
            {links.map((link) => (
              <li>
                <a
                  class="btn btn-fill"
                  href={link.href}
                  rel="noreferrer"
                  target="_blank"
                >
                  {link.label}
                  <span aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        ) : null
      }
    </section>

    {
      heroSrc ? (
        <div class="hero-shot">
          <div class="shot">
            <Image
              src={heroSrc}
              alt={item.hero?.alt || item.title}
              widths={[800, 1200, 1600, 2400]}
              sizes="(max-width: 800px) 800px, (max-width: 1200px) 1200px, (max-width: 1600px) 1600px, 2400px"
            />
          </div>
        </div>
      ) : (
        <ImageFrame hint={item.hero?.hint || item.title} />
      )
    }

    {
      rich && (
        <article class="case-body">
          {c?.context?.length ? (
            <div class="case-split">
              <h2>Context</h2>
              <div class="case-copy">
                {c.context.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            </div>
          ) : null}

          {c?.roleDetail ? (
            <div class="case-split">
              <h2>Role</h2>
              <aside class="case-copy case-role">
                <p>{c.roleDetail}</p>
              </aside>
            </div>
          ) : null}

          {c?.decisions?.length ? (
            <div class="case-split">
              <h2>Process</h2>
              <div class="case-copy">
                <ol class="case-decisions">
                  {c.decisions.map((d, i) => (
                    <li class="case-decision">
                      <span class="n">{String(i + 1).padStart(2, "0")}</span>
                      <div>
                        <h3>{d.title}</h3>
                        <p>{d.body}</p>
                      </div>
                    </li>
                  ))}
                </ol>
              </div>
            </div>
          ) : null}

          {c?.visuals?.length ? (
            <div class="case-split">
              <h2>Visuals</h2>
              <div class="case-copy">
                {c.visuals.map((visual, index) => {
                  const key = index;
                  switch (visual.kind) {
                    case "shots":
                      return (
                        <figure class="shots" data-visual={key}>
                          <div class="shots-grid">
                            {visual.shots.map((shot) => (
                              <div class="shot">
                                <ImageFrame src={shot.src} hint={shot.hint} />
                              </div>
                            ))}
                          </div>
                          {visual.caption ? <figcaption>{visual.caption}</figcaption> : null}
                        </figure>
                      );
                    case "code":
                      return (
                        <div class="code-block" data-visual={key}>
                          <div class="code-bar">
                            <span class="code-dot"></span>
                            <span class="code-name">{visual.filename}</span>
                          </div>
                          <pre>
                            <code set:html={visual.html} />
                          </pre>
                        </div>
                      );
                    case "compare":
                      return (
                        <figure class="compare" data-visual={key}>
                          <div class="compare-grid">
                            <div class="compare-pane">
                              <span class="compare-label">Before</span>
                              <div class="shot">
                                <ImageFrame src={visual.before.src} hint={visual.before.hint} />
                              </div>
                            </div>
                            <div class="compare-pane">
                              <span class="compare-label">After</span>
                              <div class="shot">
                                <ImageFrame src={visual.after.src} hint={visual.after.hint} />
                              </div>
                            </div>
                          </div>
                          {visual.caption ? <figcaption>{visual.caption}</figcaption> : null}
                        </figure>
                      );
                    default: {
                      const _exhaustive: never = visual;
                      return _exhaustive;
                    }
                  }
                })}
              </div>
            </div>
          ) : null}

          {c?.outcome?.length || c?.stats?.length ? (
            <div class="case-split">
              <h2>Outcome</h2>
              <div class="case-copy">
                {c?.outcome?.map((p) => (
                  <p>{p}</p>
                ))}
                {c?.stats?.length ? (
                  <div class="stats">
                    {c.stats.map((s) => (
                      <div class="stat">
                        <div class="stat-n">{s.n}</div>
                        <div class="stat-l">{s.label}</div>
                      </div>
                    ))}
                  </div>
                ) : null}
              </div>
            </div>
          ) : null}

          {c?.reflections?.length ? (
            <div class="case-split">
              <h2>Reflections</h2>
              <div class="case-copy">
                {c.reflections.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            </div>
          ) : null}

          {next && next.id !== item.id ? (
            <div class="next-row">
              <span class="link-quiet">Next case study</span>
              <a href={`/work/${next.id}`}>{next.title} →</a>
            </div>
          ) : null}
        </article>
      )
    }

    {
      !rich && next && next.id !== item.id ? (
        <article class="case-body">
          <div class="next-row">
            <span class="link-quiet">Next case study</span>
            <a href={`/work/${next.id}`}>{next.title} →</a>
          </div>
        </article>
      ) : null
    }
  </div>
</BaseLayout>
