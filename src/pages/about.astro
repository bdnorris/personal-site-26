---
import BaseLayout from "../layouts/BaseLayout.astro";
import ImageFrame from "../components/ImageFrame.astro";
import { getSite } from "../lib/site";

const site = getSite();
---

<BaseLayout title="About · Brian Norris" description="Hello, I'm Brian — a front-end developer in Springfield, MO.">
  <div class="wipe">
    <section class="about">
      <h1>Hello, I'm<br /><span class="acc">Brian</span></h1>
      <div class="prose">
        <div class="portrait">
          <ImageFrame src="/images/me.webp" hint={site.about.portraitHint} alt="A man with a bald head, glasses, and a beard is smiling slightly. He is wearing a blue button-up shirt with small white patterns, and the background is a plain light color." />
        </div>
        {site.about.intro.map((p) => <p>{p}</p>)}
      </div>
      <div class="contact-bar">
        <div class="top">Get in touch</div>
        {
          site.contacts.map((c) => (
            <a class="contact-row" href={c.href}>
              <span class="k">{c.k}</span>
              <span class="v">{c.v}</span>
            </a>
          ))
        }
      </div>
    </section>
