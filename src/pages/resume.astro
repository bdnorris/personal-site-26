---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSite } from "../lib/site";

const site = getSite();
const email = site.contacts.find((contact) => contact.k === "Email");
const phone = site.contacts.find((contact) => contact.k === "Phone");
const roleParts = site.role.trim().split(/\s+/);
const roleTail = roleParts.length > 0 ? roleParts[roleParts.length - 1] : site.role;
const roleLead = roleParts.slice(0, -1);
---

<BaseLayout title="Resume · Brian Norris" description="Senior front-end developer in Springfield, MO.">
  <div class="wipe resume">
    <div class="resume-head">
      <div>
        <h1>Brian Norris</h1>
        <p>
          {
            roleLead.map((word) => (
              <span class="resume-keep">{word}</span>
            ))
          }
          <span class="resume-keep">{roleTail} · {site.location}</span>
        </p>
      </div>
    </div>

    <div class="resume-actions">
      {
        email ? (
          <a class="btn btn-fill" href={email.href} aria-label={`${email.k} ${email.v}`}>
            {email.v}
          </a>
        ) : null
      }
      {
        phone ? (
          <a class="btn btn-ghost" href={phone.href} aria-label={`${phone.k} ${phone.v}`}>
            {phone.v}
          </a>
        ) : null
      }
      <a class="btn btn-ghost" href="/brian-norris-resume.pdf" download>
        Download PDF
      </a>
    </div>

    <section class="resume-block">
      <h2>Work experience</h2>
      <div class="jobs">
        {
          site.jobs.map((j) => (
            <div class="job">
              <div class="job-dates">{j.dates}</div>
              <div class="job-body">
                <h3>{j.role}</h3>
                <p class="org">{j.org}</p>
                {j.body ? <p>{j.body}</p> : null}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="resume-block">
      <h2>Professional skills</h2>
      <div class="resume-skills">
        {
          site.resumeSkills.map((g) => (
            <div>
              <h3>{g.title}</h3>
              <ul>
                {g.items.map((i) => (
                  <li>
                    <span class="k">{i.k}</span>
                    <span class="v">{i.v}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="resume-block">
      <h2>Education</h2>
      <div class="edu">
        <div class="edu-dates">{site.education.dates}</div>
        <div class="edu-body">
          <h3>{site.education.degree}</h3>
          <p class="org">{site.education.school}</p>
          <p>{site.education.note}</p>
        </div>
      </div>
    </section>

    <div class="resume-actions resume-actions--end">
      {
        email ? (
          <a class="btn btn-fill" href={email.href} aria-label={`${email.k} ${email.v}`}>
            {email.v}
          </a>
        ) : null
      }
      {
        phone ? (
          <a class="btn btn-ghost" href={phone.href} aria-label={`${phone.k} ${phone.v}`}>
            {phone.v}
          </a>
        ) : null
      }
    </div>
  </div>
</BaseLayout>
